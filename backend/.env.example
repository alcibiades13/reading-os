# Django Configuration
# IMPORTANT: Generate a new secret key for production!
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-change-this-in-production
DEBUG=True

# Allowed Hosts (comma-separated)
# For production, add your Render domain: your-app.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
DB_NAME=reading_os
DB_USER=postgres
DB_PASSWORD=your-password-here
DB_HOST=localhost
DB_PORT=5432

# CORS Settings (comma-separated)
# For production, add your frontend domain: https://your-frontend.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:5175,http://localhost:3000

# Media Files
MEDIA_URL=/media/
MEDIA_ROOT=media

# Hardcover.app API (optional - for book metadata import)
HARDCOVER_API_TOKEN=

# Email Configuration (production)
# EMAIL_HOST=smtp.your-provider.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-email-password
# DEFAULT_FROM_EMAIL=noreply@readingos.com
